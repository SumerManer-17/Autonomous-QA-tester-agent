# Autonomous QA Testing Agent - configuration
# Copy this file to .env and adjust values. Never commit real API keys.

# Server
QA_HOST=127.0.0.1
QA_PORT=8000
QA_DEBUG=true
QA_LOG_LEVEL=INFO

# Database (SQLite, relative to project root)
QA_DATABASE_URL=data/qa_agent.db

# Artifacts
QA_ARTIFACTS_DIR=artifacts
QA_SCREENSHOTS_DIR=artifacts/screenshots
QA_TRACES_DIR=artifacts/traces
QA_LOGS_DIR=artifacts/logs

# Exploration limits
QA_MAX_CRAWL_PAGES=10
QA_MAX_CRAWL_DEPTH=2
QA_MAX_ACTIONS_PER_RUN=60
QA_MAX_RUN_SECONDS=300

# Timeouts (milliseconds)
QA_ACTION_TIMEOUT_MS=10000
QA_NAVIGATION_TIMEOUT_MS=30000

# Browser
QA_BROWSER=chromium
QA_HEADLESS=true

# LLM (optional). Set QA_LLM_MODE=disabled to run fully deterministic.
# Supported: disabled, openai, groq, ollama
QA_LLM_MODE=disabled
QA_LLM_API_KEY=
QA_LLM_BASE_URL=
QA_LLM_MODEL=

# Allowed target hosts (localhost ranges allowed by default)
QA_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Demo application server port
QA_DEMO_PORT=3000
